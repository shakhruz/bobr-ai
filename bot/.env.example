# Скопируйте в .env и заполните. .env в git/архив не кладите.
BOT_TOKEN=123456:ABC-from-BotFather
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5-5 (по умолчанию) | claude-haiku-5-5 (дешевле) | claude-opus-5-5 (умнее)
ANTHROPIC_MODEL=claude-sonnet-5-5
DB_PATH=bobr.db
# Глубина рассуждения (low = быстро). Пусто = не передавать параметр.
ANTHROPIC_EFFORT=low
